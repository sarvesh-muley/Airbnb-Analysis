	column 'Review Count' = CALCULATE(COUNTROWS(Reviews)) + 0
		formatString: 0
		lineageTag: 81b4fdf7-73bb-465d-abcb-b14518ec6b09
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Last Review Date' = CALCULATE(MAX(Reviews[date]))
		formatString: General Date
		lineageTag: 5cee797b-37ad-4a02-843d-c9f7e48b8a25
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 0804937d-af5a-4c59-bd59-c8a075e2b039
			defaultHierarchy: LocalDateTable_0ff1526d-06cd-4d96-899e-3394dbe2688d.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Days Since Last Review' = ```
			
			VAR MaxDatasetDate = CALCULATE(MAX(Reviews[date]), ALL(Reviews))
			RETURN 
			IF(
			    ISBLANK(Listings[Last Review Date]), 
			    BLANK(),
			    DATEDIFF(Listings[Last Review Date], MaxDatasetDate, DAY)
			)
			```
		formatString: 0
		lineageTag: 3cc4967f-456b-4011-a576-80bd94b930a7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Listing Status' =
			
			SWITCH(
			    TRUE(),
			    Listings[Review Count] = 0, "No Reviews",
			    Listings[Days Since Last Review] <= 180, "Active",
			    Listings[Days Since Last Review] <= 365, "Slowing",
			    "Dormant"
			)
		lineageTag: f3069eda-ce74-4a1b-8648-f5cfd151789d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Price per Guest' = DIVIDE(Listings[price], Listings[accommodates])
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: b4471bb0-0022-4fde-8448-b2a10f384536
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	column 'Amenities Count' =
			
			VAR CleanText = TRIM(Listings[amenities])
			RETURN
			IF(
			    ISBLANK(CleanText) || CleanText = "[]" || CleanText = "",
			    0,
			    LEN(CleanText) - LEN(SUBSTITUTE(CleanText, ",", "")) + 1
			)
		formatString: 0
		lineageTag: 59ab4e3f-3a33-4909-91aa-f948e3c9f753
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Min Stay Band' =
			
			SWITCH(
			    TRUE(),
			    Listings[minimum_nights] <= 2, "1-2 nights",
			    Listings[minimum_nights] <= 7, "3-7 nights",
			    Listings[minimum_nights] <= 30, "8-30 nights",
			    "30+ nights"
			)
		lineageTag: eb498fa6-2d10-4f73-b288-a167943eabb6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Price Tier' = ```
			
			VAR P25 = CALCULATE(PERCENTILE.INC(Listings[price], 0.25), ALLEXCEPT(Listings, Listings[city]))
			VAR P75 = CALCULATE(PERCENTILE.INC(Listings[price], 0.75), ALLEXCEPT(Listings, Listings[city]))
			RETURN 
			SWITCH(
			    TRUE(),
			    Listings[price] <= P25, "Budget",
			    Listings[price] <= P75, "Mid-range",
			    "Premium"
			)
			```
		lineageTag: bbc2cf7e-c4aa-4e9a-ba1d-2cf7c913dd76
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Peer Median Price' =
			
			CALCULATE(
			    MEDIAN(Listings[price]),
			    ALLEXCEPT(Listings, Listings[city], Listings[neighbourhood], Listings[room_type])
			)
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: 891d3fc7-8079-41c2-8bd9-488f9d6bcdf6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	column 'Pricing Action' = ```
			
			VAR Ratio = DIVIDE(Listings[price], Listings[Peer Median Price])
			RETURN 
			SWITCH(
			    TRUE(),
			    ISBLANK(Listings[review_scores_rating]), "Unrated - Monitor",
			    Ratio > 1.5 && Listings[review_scores_rating] < 90, "Review: Overpriced",
			    Ratio < 0.7 && Listings[review_scores_rating] >= 95, "Opportunity: Raise price",
			    "OK"
			)
			```
		lineageTag: 09a1d7cd-5a85-4c1a-b09e-f37178dda651
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Response Time Order'
		dataType: int64
		formatString: 0
		lineageTag: 55bbd8cc-c1ed-4469-9096-b68f415771ff
		summarizeBy: sum
		sourceColumn: Response Time Order

		annotation SummarizationSetBy = Automatic

